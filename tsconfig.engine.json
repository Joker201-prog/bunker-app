{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "rootDir": "src",
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".build"
  },
  "include": [
    "src/game/**/*.ts",
    "src/data/**/*.ts",
    "src/server/**/*.ts"
  ],
  "exclude": [
    "src/game/useLocalGame.ts"
  ]
}